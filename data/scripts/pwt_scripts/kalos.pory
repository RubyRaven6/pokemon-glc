script EventScript_PWTBattleViola{
    msgbox("I'm Brock!\nMy Pokémon are rock hard!")
    trainerbattle_no_intro(TRAINER_LEADER_VIOLA, "Seems like I've gone soft…")
    call(EventScript_PWTBattleViola_Money)
    return
}

script(local) EventScript_PWTBattleViola_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_VIOLA){
        setflag(FLAG_KALOS_LEADER_VIOLA)
        addmoney(500)
        if(!flag(FLAG_COMPLETED_KALOS_TOURNAMENT)){setflag(FLAG_COMPLETED_KALOS_TOURNAMENT)}
    } else {
        addmoney(250)
    }
}

