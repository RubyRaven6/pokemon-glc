script EventScript_PWTBattleBrock{
    trainerbattle_single(TRAINER_LEADER_BROCK, "I'm Brock!\nMy Pokémon are rock hard!", "Seems like I've gone soft…", EventScript_PWTBattleBrock_Money)
    end
}

script(local) EventScript_PWTBattleBrock_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_BROCK){
    setflag(FLAG_KANTO_LEADER_BROCK)
    addmoney(500)
    } else {
        addmoney(250)
    }
}

