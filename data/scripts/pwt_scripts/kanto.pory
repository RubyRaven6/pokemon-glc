script EventScript_PWTBattleBrock{
    msgbox("I'm Brock!\nMy Pokémon are rock hard!")
    trainerbattle_no_intro(TRAINER_LEADER_BROCK, "Seems like I've gone soft…")
    call(EventScript_PWTBattleBrock_Money)
    return
}

script(local) EventScript_PWTBattleBrock_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_BROCK){
        setflag(FLAG_KANTO_LEADER_BROCK)
        addmoney(500)
        if(!flag(FLAG_COMPLETED_KANTO_TOURNAMENT)){setflag(FLAG_COMPLETED_KANTO_TOURNAMENT)}
    } else {
        addmoney(250)
    }
}

