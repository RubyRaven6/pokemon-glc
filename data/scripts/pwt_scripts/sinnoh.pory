script EventScript_PWTBattleRoark{
    trainerbattle_single(TRAINER_LEADER_ROARK, "TRAINER_LEADER_ROARK", "TRAINER_LEADER_ROARK lost",EventScript_PWTBattleRoark_Money)
    return
}

script(local) EventScript_PWTBattleRoark_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_ROARK) {
        setflag(FLAG_SINNOH_LEADER_ROARK)
        addmoney(500)
    } else {
        addmoney(250)
    }
}

