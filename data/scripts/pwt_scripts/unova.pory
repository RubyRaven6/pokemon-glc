script EventScript_PWTBattleLenora{
    msgbox("TRAINER_LEADER_LENORA")
    trainerbattle_no_intro(TRAINER_LEADER_LENORA, "TRAINER_LEADER_LENORA lost")
    call(EventScript_PWTBattleLenora_Money)
    return
}

script(local) EventScript_PWTBattleLenora_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_LENORA) {
        setflag(FLAG_UNOVA_LEADER_LENORA)
        if(!flag(FLAG_COMPLETED_UNOVA_TOURNAMENT)){setflag(FLAG_COMPLETED_UNOVA_TOURNAMENT)}
        addmoney(500)
    } else {
        addmoney(250)
    }
}

