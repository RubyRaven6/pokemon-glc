script EventScript_PWTBattleLenora{
    trainerbattle_single(TRAINER_LEADER_LENORA, "TRAINER_LEADER_LENORA", "TRAINER_LEADER_LENORA lost", EventScript_PWTBattleLenora_Money)
    return
}

script(local) EventScript_PWTBattleLenora_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_LENORA) {
        setflag(FLAG_UNOVA_LEADER_LENORA)
        addmoney(500)
    } else {
        addmoney(250)
    }
}

