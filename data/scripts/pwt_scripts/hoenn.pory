script EventScript_PWTBattleRoxanne{
    trainerbattle_single(TRAINER_LEADER_ROXANNE, "TRAINER_LEADER_ROXANNE", "TRAINER_LEADER_ROXANNE lost",EventScript_PWTBattleRoxanne_Money)
    return
}

script(local) EventScript_PWTBattleRoxanne_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_ROXANNE) {
        setflag(FLAG_HOENN_LEADER_ROXANNE)
        if(!flag(FLAG_COMPLETED_HOENN_TOURNAMENT)){setflag(FLAG_COMPLETED_HOENN_TOURNAMENT)}
        addmoney(500)
    } else {
        addmoney(250)
    }
}

