script EventScript_PWTBattleFalkner{
    msgbox("TRAINER_LEADER_FALKNER")
    trainerbattle_no_intro(TRAINER_LEADER_FALKNER, "TRAINER_LEADER_FALKNER lost")
    call(EventScript_PWTBattleFalkner_Money)
    return
}

script(local) EventScript_PWTBattleFalkner_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_FALKNER) {
        setflag(FLAG_JOHTO_LEADER_FALKNER)
        if(!flag(FLAG_COMPLETED_JOHTO_TOURNAMENT)){setflag(FLAG_COMPLETED_JOHTO_TOURNAMENT)}
        addmoney(500)
    } else {
        addmoney(250)
    }
}

