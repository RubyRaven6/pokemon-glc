script EventScript_PWTBattleFalkner{
    trainerbattle_single(TRAINER_LEADER_FALKNER, "TRAINER_LEADER_FALKNER", "TRAINER_LEADER_FALKNER lost", EventScript_PWTBattleFalkner_Money)
    end
}

script(local) EventScript_PWTBattleFalkner_Money {
    if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_FALKNER) {
        setflag(FLAG_JOHTO_LEADER_FALKNER)
        addmoney(500)
    } else {
        addmoney(250)
    }
}

