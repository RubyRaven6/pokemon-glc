mapscripts TestingGrounds_BattleArena_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        switch(var(VAR_GYM_LEADER_BATTLE_COUNT))
        {
            case 1:
                setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_ROXANNE)
            case 2:
                setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BRAWLY)
            case 3:
                setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_WATTSON)
        }
    }
    MAP_SCRIPT_ON_TRANSITION{
        switch(var(VAR_GYM_LEADER_BATTLE_COUNT))
        {
        case 1:
            if(var(VAR_GYM_LEADER_1) == TRAINER_LEADER_KOGA_AND_JANINE || var(VAR_GYM_LEADER_1) == TRAINER_LEADER_TATE_AND_LIZA){setflag(FLAG_TEMP_1)}
            else{setflag(FLAG_TEMP_2)}
        case 2:
            if(var(VAR_GYM_LEADER_2) == TRAINER_LEADER_KOGA_AND_JANINE || var(VAR_GYM_LEADER_2) == TRAINER_LEADER_TATE_AND_LIZA){setflag(FLAG_TEMP_1)}
            else{setflag(FLAG_TEMP_2)}
        case 3:
            if(var(VAR_GYM_LEADER_3) == TRAINER_LEADER_KOGA_AND_JANINE || var(VAR_GYM_LEADER_3) == TRAINER_LEADER_TATE_AND_LIZA){setflag(FLAG_TEMP_1)}
            else{setflag(FLAG_TEMP_2)}
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: GymLeaderBattleSetup
    ]
}

script GymLeaderBattleSetup {
    lock
    applymovement(LOCALID_PLAYER, moves(walk_up * 6, delay_16 *2))
    waitmovement(0)
    closemessage
    setvar(VAR_LAST_TALKED, 1)
    switch(var(VAR_GYM_LEADER_BATTLE_COUNT))
    {
        case 1:
            call_pwt_script(VAR_GYM_LEADER_1)
            addvar(VAR_GYM_LEADER_BATTLE_COUNT,1)
        case 2:
            call_pwt_script(VAR_GYM_LEADER_2)
            addvar(VAR_GYM_LEADER_BATTLE_COUNT,1)
        case 3:
            call_pwt_script(VAR_GYM_LEADER_3)
            setvar(VAR_GYM_LEADER_BATTLE_COUNT,1)
            callnative(ChooseRandomGymLeader)
    }
    msgbox("Our winner is {PLAYER}!")
    waitmessage
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_down * 6, delay_16 *2))
    waitmovement(0)
    warp(MAP_TESTING_GROUNDS_GREEN_ROOM, 2, 3)
    waitstate
    release
    end
}