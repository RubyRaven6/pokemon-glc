mapscripts TournamentGrounds_GreenRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
    special(HealPlayerParty)
    setflag(FLAG_DISABLE_SAVING)
    }

    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_0, 0 {
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            setvar(VAR_TEMP_0, 1)
        }
    ]

}

script TournamentGrounds_GreenRoom_EventScript_Teala {
    lockall
    faceplayer
    
}

script(local) TournamentGrounds_GreenRoom_ChallengeProceed {
    setspeaker(SP_NAME_TEALA)
    msgbox(format("Are you ready to go to the next round?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO){}
    else
    {
        checkpartyfortech
        if(var(VAR_RESULT) > 1)
        {
            msgbox(format("You have two or more Pokemon with a signature move.\pKindly ensure only one signature move is present in your party."))
            closemessage
            applymovement(LOCALID_PLAYER, moves(walk_down))
            waitmovement(0)
        }
        else
        {
            callnative(ChooseRandomGymLeader)
            setspeaker(SP_NAME_TEALA)
            msgbox(format("Good luck!"))
            closemessage
            warp(MAP_TESTING_GROUNDS_BATTLE_ARENA, 6, 12)
            waitstate
        }
    }
    releaseall
    end
}