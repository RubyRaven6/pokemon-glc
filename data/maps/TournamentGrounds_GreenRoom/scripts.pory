mapscripts TournamentGrounds_GreenRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(HealPlayerParty)
        setflag(FLAG_DISABLE_SAVING)
        if(var(VAR_GYM_LEADER_1) == 0 || var(VAR_GYM_LEADER_2) == 0 || var(VAR_GYM_LEADER_3) == 0)
            {callnative(ChooseRandomGymLeader)}
    }

    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_0, 0 {
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            setvar(VAR_TEMP_0, 1)
        }
    ]

}

script(local) BufferNextOpponentName
{
    switch(var(VAR_GYM_LEADER_BATTLE_COUNT))
    {
        case 1:
            buffertrainername(STR_VAR_1, VAR_GYM_LEADER_1)
        case 2:
            buffertrainername(STR_VAR_1, VAR_GYM_LEADER_2)
        case 3:
            buffertrainername(STR_VAR_1, VAR_GYM_LEADER_3)
    }
}

script TournamentGrounds_GreenRoom_EventScript_Teala {
    lockall
    faceplayer
    setspeaker(SP_NAME_TEALA)
    call(BufferNextOpponentName)
    msgbox(format("Your next opponent will be {STR_VAR_1}."))
    msgbox(format("Are you ready to go to the next round?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO){}
    else
    {
        checkpartyfortech
        if(var(VAR_RESULT) > 1)
        {
            msgbox(format("You have two or more Pokemon with a signature move.\pKindly ensure only one signature move is present in your party."))
            closemessage
            applymovement(LOCALID_PLAYER, moves(walk_down))
            waitmovement(0)
        }
        else
        {
            setspeaker(SP_NAME_TEALA)
            msgbox(format("Good luck!"))
            closemessage
            warp(MAP_TOURNAMENT_GROUNDS_BATTLE_ROOM, 4, 9)
            waitstate
        }
    }
    releaseall
    end
}