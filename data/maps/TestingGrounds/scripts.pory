mapscripts TestingGrounds_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_TESTING_GROUNDS)
    }
}

script PWT_Battler1 {
    call_pwt_script(VAR_GYM_LEADER_1)
}

script PWT_Battler2 {
    call_pwt_script(VAR_GYM_LEADER_2)
}

script PWT_Battler3 {
    call_pwt_script(VAR_GYM_LEADER_3)
}

script ScriptWithPokemart {
	lock
	message("buymywares.com")
	waitmessage
	pokemart(MyMartItems)
	msgbox("Come again soon.")
	release
}

mart MyMartItems {
	ITEM_LAVA_COOKIE
	ITEM_MOOMOO_MILK
	ITEM_RARE_CANDY
	ITEM_LEMONADE
	ITEM_BERRY_JUICE
    ITEM_TM_MAGMATIC_RAGE
}