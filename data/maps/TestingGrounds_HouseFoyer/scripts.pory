script EventScript_TestingGrounds_HouseFoyer_TechniquesMarket{
    lock
    faceplayer
	msgbox("techniques.com")
    checkdefeatedleaders
    if(var(VAR_RESULT) == FALSE){
        msgbox(format("This shop unlocks once you defeat a gym leader."))
        closemessage
    } else {
        msgbox(format("Kindly choose which techniques you'd like to claim."))
        pokemart(TechniquesMarket)
        msgbox("Good luck.")
    }
    applymovement(VAR_LAST_TALKED, moves(face_original_direction))
    waitmovement(0)
    closemessage
	release
}

script EventScript_TestingGrounds_HouseFoyer_CheckForTech {
    lock
    checkpartyfortech
    if(var(VAR_RESULT) > 1)
    {
        msgbox(format("You have two or more Pokemon with a signature move.\pKindly ensure only one signature move is present in your party."))
        closemessage
        applymovement(LOCALID_PLAYER, moves(walk_down))
        waitmovement(0)
    }
    else{}
}

