mapscripts TestingGrounds_HouseFoyer_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_TESTING_GROUNDS_HOUSE_FOYER)
        special(HealPlayerParty)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GENERATION_CTL, 0 {
            msgbox(format(
                "Hello, and welcome to the PWT romhack!\p"
                "To get started, we've given you three starters in your team, and even more in the box!\p"
                "Once you beat all the gym leaders at the finals (the third round), you unlock the next generation's leaders and Pokemon.\p"
                "You can then enter the room through the stairs again.\p"
                "Whenever you've unlocked more generations, you can check the books in the corner to select a generation too!\p"
                "Doing so also randomizes the gym leaders you may face.\p"
                "Lastly, speak to the NPCs to buy items, and check the computer on the left to change your Pokémon's ability, nature, and tera type.\p"
                "Have fun!"
                ))
            closemessage
            setvar(VAR_GENERATION_CTL, 1)
            callnative(ChooseRandomGymLeader)
            if(!flag(FLAG_SYS_POKEMON_GET)){setflag(FLAG_SYS_POKEMON_GET)}
            callnative(GivePlayerUnlockedPokemon)
            callnative(GiveStartingKeyItems)
            special(HealPlayerParty)
        }
    ]
}

script EventScript_TestingGrounds_HouseFoyer_GenerationSelector {
    lock
    dynmultipush("Generation 1", 1)
    if(flag(FLAG_COMPLETED_KANTO_TOURNAMENT)){dynmultipush("Generation 2", 2)}
    if(flag(FLAG_COMPLETED_JOHTO_TOURNAMENT)){dynmultipush("Generation 3", 3)}
    if(flag(FLAG_COMPLETED_HOENN_TOURNAMENT)){dynmultipush("Generation 4", 4)}
    if(flag(FLAG_COMPLETED_SINNOH_TOURNAMENT)){dynmultipush("Generation 5", 5)}
    dynmultistack(0, 0, FALSE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    switch(var(VAR_RESULT)){
        case 1:
            choosegeneration(1)
            bufferstring(STR_VAR_1, "1")
        case 2:
            choosegeneration(2)
            bufferstring(STR_VAR_1, "2")
        case 3:
            choosegeneration(3)
            bufferstring(STR_VAR_1, "3")
        case 4:
            choosegeneration(4)
            bufferstring(STR_VAR_1, "4")
        case 5:
            choosegeneration(5)
            bufferstring(STR_VAR_1, "5")
        default:
            bufferstring(STR_VAR_1, "0")
    }

    setspeaker("Books")
    msgbox("You've chosen Generation {STR_VAR_1}.")
    callnative(ChooseRandomGymLeader)
    msgbox(format("Random gym leaders chosen."))
    closemessage
    release
}

script EventScript_TestingGrounds_HouseFoyer_ChooseWhatToDoWithPokemon {
    msgbox(format("Hello! And welcome to the Pokémon Editor.\pYou may choose to change your Pokemon's ability, nature, and tera type."))
    dynmultichoice(0,0,FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Natures", "Ability", "Tera Type")
    switch(var(VAR_RESULT))
    {
        case 0:
            call(Debug_EventScript_SetHiddenNature)
        case 1:
            call(Debug_EventScript_SetAbility)
        case 2:
            call(Debug_EventScript_SetTeraType)
    }
    closemessage
}

script EventScript_TestingGrounds_HouseFoyer_HaterComputer {
    lock
    msgbox(format("Your ass died lmao"))
    closemessage
    delay(30)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark))
    waitmovement(0)
    release
}

script EventScript_TestingGrounds_HouseFoyer_HeldItemMarket{
    lock
    faceplayer
	message("helditems.com")
	waitmessage
	pokemart(HeldItemMarket)
	msgbox("Come again soon.")
    applymovement(VAR_LAST_TALKED, moves(face_original_direction))
    waitmovement(0)
	release
}

